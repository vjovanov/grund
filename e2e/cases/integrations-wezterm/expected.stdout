# grund wezterm citation integration
# Install with: grund integrations wezterm --write
#
# 1. Terminal config — add to ~/.config/wezterm/wezterm.lua:

-- grund citation integration for WezTerm.
-- Makes a §<ID> citation in the terminal Ctrl/Cmd-clickable: the click resolves
-- the citation with `grund` and opens the declaration in your editor via the
-- installed `grund-open` resolver (§FS-integrations).
--
-- WezTerm applies hyperlink rules only from the config object you return, so add
-- one line where you build your config:
--
--     local config = wezterm.config_builder()
--     -- ... your settings ...
--     grund_apply_hyperlink_rule(config)   -- defined below
--     return config
--
-- (The open-uri handler below is global and needs no wiring.)
local wezterm = require 'wezterm'

-- Append grund's citation rule to config.hyperlink_rules, seeding WezTerm's
-- defaults first when the config carries none of its own. A non-capturing group
-- keeps the whole citation as the $0 match.
function grund_apply_hyperlink_rule(config)
  config.hyperlink_rules = config.hyperlink_rules or wezterm.default_hyperlink_rules()
  table.insert(config.hyperlink_rules, {
    regex = '§[A-Z]+-[a-z0-9][a-z0-9-]*(?:\\.[0-9]+)*',
    format = 'grund:$0',
  })
end

-- Resolve a grund: URI by handing the citation to grund-open.
wezterm.on('open-uri', function(_window, _pane, uri)
  local citation = uri:match '^grund:(.+)$'
  if citation then
    wezterm.background_child_process { 'grund-open', citation }
    return false -- handled; don't let WezTerm open it as a normal URL
  end
end)

# 2. Resolver — install grund-open to a directory on PATH (e.g. ~/.local/bin):

#!/bin/sh
# grund-open — resolve a §<ID> citation to its declaration site and open it.
#
# Installed by `grund integrations <client> --write` (§FS-integrations). A
# terminal integration hands this script the clicked token; the script resolves
# it with `grund` and opens the declaration in the user's editor. The editor is
# GRUND_OPEN_CMD when set, else EDITOR, else a platform default — the user's
# editor choice lives here, never in shared repository text. GRUND_OPEN_CMD is
# an argv-style command prefix; use a wrapper executable for custom placement.
#
# Usage: grund-open <§ID | ID>[.<section>]
set -eu

token=${1:-}
[ -n "$token" ] || { echo "grund-open: no citation given" >&2; exit 2; }

# Strip a leading citation marker (default §) and any trailing .<section>; the
# declaration line is what we open.
id=${token#§}
id=${id%%.*}
[ -n "$id" ] || { echo "grund-open: empty id in '$token'" >&2; exit 2; }

# Resolve ID -> path:line from the ID catalog. `grund list --format json` emits
# one NDJSON object per declaration; pull the matching id's path and line.
line=$(grund list --format json 2>/dev/null | grep "\"id\":\"$id\"" | head -n 1)
[ -n "$line" ] || { echo "grund-open: unknown id '$id'" >&2; exit 1; }

path=$(printf '%s\n' "$line" | sed -n 's/.*"path":"\([^"]*\)".*/\1/p')
lineno=$(printf '%s\n' "$line" | sed -n 's/.*"line":\([0-9]*\).*/\1/p')
[ -n "$path" ] || { echo "grund-open: could not resolve path for '$id'" >&2; exit 1; }
lineno=${lineno:-1}

if [ -n "${GRUND_OPEN_CMD:-}" ]; then
    # Never interpolate the repository-controlled path into shell source. The
    # command itself is user-controlled and may carry simple flags; it receives
    # one path:line argument. More complex layouts belong in a wrapper script.
    # shellcheck disable=SC2086
    set -f
    set -- $GRUND_OPEN_CMD
    set +f
    [ "$#" -gt 0 ] || { echo "grund-open: GRUND_OPEN_CMD contains no command" >&2; exit 2; }
    exec "$@" "$path:$lineno"
elif [ -n "${EDITOR:-}" ]; then
    # EDITOR may carry flags (e.g. "code -w" or "emacsclient -t"), so word-split
    # it, then pass the line in the syntax the editor understands: only the
    # vi/emacs family take "+LINE FILE"; VS Code / Sublime want "--goto
    # FILE:LINE"; helix/micro take "FILE:LINE". Unknown editors just open FILE.
    # shellcheck disable=SC2086
    set -- $EDITOR
    case $(basename "$1") in
        code|code-insiders|codium|vscodium|cursor|subl|sublime_text)
            exec "$@" --goto "$path:$lineno" ;;
        vi|vim|nvim|nano|emacs|emacsclient|kak)
            exec "$@" "+$lineno" "$path" ;;
        hx|micro)
            exec "$@" "$path:$lineno" ;;
        *)
            exec "$@" "$path" ;;
    esac
elif command -v code >/dev/null 2>&1; then
    exec code --goto "$path:$lineno"
else
    echo "grund-open: set GRUND_OPEN_CMD or EDITOR to open $path:$lineno" >&2
    exit 1
fi
