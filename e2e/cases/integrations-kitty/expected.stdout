# grund kitty citation integration
# Install with: grund integrations kitty --write
#
# 1. Terminal config — add to ~/.config/kitty/kitty.conf:

# grund citation integration for kitty.
# kitty does not make arbitrary text clickable, so this binds a key that runs
# the "hints" kitten over the visible screen, matches §<ID> citations, and hands
# the one you pick to the installed `grund-open` resolver (§FS-integrations).
# Paste into kitty.conf, or let `grund integrations kitty --write` manage it.
#
# Press ctrl+shift+g, then the hint label over the citation you want to open.
# Every group is non-capturing: kitty's hints kitten passes the first capture
# group when one is present, so a capturing group here would hand grund-open a
# fragment — the `.<section>`, or the alias — instead of the whole citation.
#
# The leading `[^\w\s]{1,3}` matches the citation marker without naming it.
# `[reference] marker` is per-repo while this file is user-global and installed
# once, so hardcoding § would leave every repo with a custom marker silently
# unclickable. grund-open strips whatever punctuation this sweeps in.
map ctrl+shift+g kitten hints --type regex --regex '[^\w\s]{1,3}(?:[a-z][a-z0-9-]*/)?[A-Z][A-Z0-9]*-[a-z0-9][a-z0-9-]*(?:\.[0-9]+)*' --program 'grund-open'

# Press ctrl+shift+p to *peek* instead: the declaration opens in an overlay
# window over this one, and closes when you quit the pager. kitty has no hover,
# so this is the read-without-leaving path (§FS-integrations.3.3).
map ctrl+shift+p kitten hints --type regex --regex '[^\w\s]{1,3}(?:[a-z][a-z0-9-]*/)?[A-Z][A-Z0-9]*-[a-z0-9][a-z0-9-]*(?:\.[0-9]+)*' --program 'launch --type=overlay grund-open --peek'

# 2. Resolver — install grund-open to a directory on PATH (e.g. ~/.local/bin):

#!/bin/sh
# grund-open — resolve a §<ID> citation to its cited line and open it.
#
# Installed by `grund integrations <client> --write` (§FS-integrations). A
# terminal integration hands this script the clicked token; the script resolves
# it with `grund` and opens the declaration in the user's editor. The editor is
# GRUND_OPEN_CMD when set, else EDITOR, else a platform default — the user's
# editor choice lives here, never in shared repository text. GRUND_OPEN_CMD is
# an argv-style command prefix; use a wrapper executable for custom placement.
#
# With --peek it prints the declaration through a pager instead, for clients that
# can put it in an overlay, popup, or split pane. Both modes share one resolution
# path so a peek and a click can never disagree about where a citation points.
#
# Usage: grund-open [--peek] <§ID | ID>[.<section>]
set -eu

peek=
if [ "${1:-}" = "--peek" ]; then
    peek=1
    shift
fi

token=${1:-}
[ -n "$token" ] || { echo "grund-open: no citation given" >&2; exit 2; }

# Strip the citation marker without hardcoding one: `[reference] marker` is
# per-repo, so drop any leading run of non-alphanumeric characters instead of a
# literal §. This keeps a workspace-qualified `<alias>/<ID>` intact (the alias
# starts alphanumeric) and tolerates stray punctuation the terminal's match
# swept in, e.g. `(§FS-x`. The section suffix is deliberately kept: `grund`
# resolves `<ID>.<section>` to that section's own line.
id=$(printf '%s' "$token" | sed 's/^[^A-Za-z0-9]*//')
[ -n "$id" ] || { echo "grund-open: empty id in '$token'" >&2; exit 2; }

# Find the root and resolve in one climb (§FS-integrations.3.1). The terminal
# hands us a token, never a directory, so the click may arrive with the shell
# anywhere in the tree. Try every ancestor holding `.agents/grund.toml`,
# nearest first — nearest alone is not enough: from inside a workspace member
# the member's config resolves its own bare IDs, but a workspace-qualified
# `<alias>/<ID>` only resolves from the workspace root above it, so on failure
# the climb continues upward instead of giving up.
#
# `grund <ID>[.<section>] --format json` emits one object whose `path` is
# relative to the root it ran in and whose `line` is the cited section's line,
# not merely the declaration's.
json=''
root=''
seen_config=''
dir=$PWD
while :; do
    if [ -f "$dir/.agents/grund.toml" ]; then
        seen_config=1
        if json=$(cd "$dir" && grund "$id" --format json 2>/dev/null) && [ -n "$json" ]; then
            root=$dir
            break
        fi
        json=''
    fi
    [ "$dir" = "/" ] && break
    dir=$(dirname "$dir")
done
[ -n "$seen_config" ] || {
    echo "grund-open: no .agents/grund.toml at or above $PWD" >&2
    exit 1
}
[ -n "$root" ] || { echo "grund-open: unknown id '$id'" >&2; exit 1; }

# Anchor both extractions to the end of the object: `body` carries arbitrary
# declaration prose that may itself contain `"path":` or `"line":`, and an
# unanchored match would happily read that instead of the real field. A
# directory-backed E2E declaration answers with the manifest shape instead
# (§FS-show.2.4) — no `body` and no `"line"` — so its fallback anchors on the
# grund-controlled prefix, and the case *directory* is what opens.
path=$(printf '%s\n' "$json" | sed -n 's/.*"path":"\([^"]*\)","line":[0-9]*}$/\1/p')
lineno=$(printf '%s\n' "$json" | sed -n 's/.*,"line":\([0-9]*\)}$/\1/p')
if [ -z "$path" ]; then
    path=$(printf '%s\n' "$json" | sed -n 's/^{"id":"[^"]*","kind":"E2E","path":"\([^"]*\)".*/\1/p')
    lineno=''
fi
[ -n "$path" ] || { echo "grund-open: could not resolve path for '$id'" >&2; exit 1; }
lineno=${lineno:-1}

# Hand the editor an absolute path. `grund` never emits one (§FS-errors.4 keeps
# reports deterministic); composing it here is what makes the click work from a
# subdirectory. An E2E case resolves to its directory, where a `:line` suffix
# would garble the argument, so the target drops it.
path="$root/$path"
if [ -d "$path" ]; then
    target=$path
else
    target="$path:$lineno"
fi

if [ -n "$peek" ]; then
    # Print, don't open. The caller has already put us somewhere disposable — a
    # kitty overlay, a tmux popup, a wezterm split — and every one of those
    # closes when this process exits, so the output goes through a pager to stay
    # readable until dismissed. The location header is what makes the peek
    # actionable: it is the same `path:line` a click would open.
    {
        printf '%s\n\n' "$target"
        (cd "$root" && grund "$id") 2>/dev/null || printf 'could not render %s\n' "$id"
    } | {
        if [ -n "${PAGER:-}" ]; then
            # shellcheck disable=SC2086
            exec $PAGER
        elif command -v less >/dev/null 2>&1; then
            exec less -R
        else
            cat
            printf '\n[enter to close] '
            read -r _dismiss || true
        fi
    }
    exit 0
fi

if [ -n "${GRUND_OPEN_CMD:-}" ]; then
    # Never interpolate the repository-controlled path into shell source. The
    # command itself is user-controlled and may carry simple flags; it receives
    # one path:line argument. More complex layouts belong in a wrapper script.
    # shellcheck disable=SC2086
    set -f
    set -- $GRUND_OPEN_CMD
    set +f
    [ "$#" -gt 0 ] || { echo "grund-open: GRUND_OPEN_CMD contains no command" >&2; exit 2; }
    exec "$@" "$target"
elif [ -n "${EDITOR:-}" ]; then
    # EDITOR may carry flags (e.g. "code -w" or "emacsclient -t"), so word-split
    # it, then pass the line in the syntax the editor understands: only the
    # vi/emacs family take "+LINE FILE"; VS Code / Sublime want "--goto
    # FILE:LINE"; helix/micro take "FILE:LINE". Unknown editors just open FILE,
    # and a directory target always opens bare.
    # shellcheck disable=SC2086
    set -- $EDITOR
    if [ -d "$path" ]; then
        exec "$@" "$path"
    fi
    case $(basename "$1") in
        code|code-insiders|codium|vscodium|cursor|subl|sublime_text)
            exec "$@" --goto "$path:$lineno" ;;
        vi|vim|nvim|nano|emacs|emacsclient|kak)
            exec "$@" "+$lineno" "$path" ;;
        hx|micro)
            exec "$@" "$path:$lineno" ;;
        *)
            exec "$@" "$path" ;;
    esac
elif command -v code >/dev/null 2>&1; then
    if [ -d "$path" ]; then
        exec code "$path"
    fi
    exec code --goto "$path:$lineno"
else
    echo "grund-open: set GRUND_OPEN_CMD or EDITOR to open $target" >&2
    exit 1
fi
